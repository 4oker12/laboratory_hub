{
  "manifest_version": 3,
  "name": "RouterLab — Archer C20 / Netis N2",
  "short_name": "RouterLab",
  "version": "0.8.3",
  "description": "RouterLab shared UI with isolated C20 and experimental Netis N2 FW4 adapters",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "cookies",
    "declarativeNetRequestWithHostAccess",
    "offscreen",
    "webRequest"
  ],
  "host_permissions": [
    "http://192.168.0.1/*",
    "http://192.168.1.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "RouterLab — Archer C20"
  },
  "content_scripts": [
    {
      "matches": [
        "http://192.168.0.1/*"
      ],
      "all_frames": true,
      "js": [
        "offscreen-vendor-control-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://192.168.0.1/*"
      ],
      "all_frames": true,
      "js": [
        "offscreen-vendor-read-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://192.168.0.1/*"
      ],
      "all_frames": true,
      "js": [
        "offscreen-frame-probe.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
